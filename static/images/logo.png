<script src="js/slim.js"></script>
<script src="lib/parsleyjs/js/parsley.js"></script>
<script>
$(".btn-submitted").on('click', function(e) {
    var clickedButton = $(this);
    var form = clickedButton.closest('form');

    if (form.parsley().isValid()) {
        var originalClasses = clickedButton.attr('class');
        var loadingButtonHtml = '<a href="#" class="' + originalClasses + ' disabled">Mohon Menunggu...</a>';
        clickedButton.hide();
        clickedButton.after(loadingButtonHtml);
        return true;
    }
});

</script>  </body>
